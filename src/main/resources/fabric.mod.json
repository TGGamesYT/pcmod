{
  "schemaVersion": 1,
  "id": "pcmod",
  "version": "${version}",
  "name": "pcmod",
  "description": "Build a PC for your friend!",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/pcmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "dev.tggamesyt.pcmod.client.PcmodDataGenerator"
    ],
    "client": [
      "dev.tggamesyt.pcmod.client.PcmodClient"
    ],
    "main": [
      "dev.tggamesyt.pcmod.Pcmod"
    ]
  },
  "mixins": [
    "pcmod.mixins.json",
    {
      "config": "pcmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
